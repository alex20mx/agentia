{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentia",
  "version": "1.0.0",
  "identifier": "mx.codefy.agentia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Agentia",
        "width": 1400,
        "height": 880,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#030304",
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Dirige a todas tus IAs. Sin comerte la RAM.",
    "longDescription": "Corre Claude Code, Codex, Copilot CLI y OpenCode en paralelo, cada uno en su propia rama de git.",
    "publisher": "Codefy",
    "copyright": "\u00a9 2026 Codefy",
    "homepage": "https://codefy.com.mx"
  }
}